---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../data/site";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  jsonLd?: object;
  /** When true, header is shown transparent over a dark hero on this page. */
  darkHero?: boolean;
}

const {
  title,
  description = SITE.shortDesc,
  ogImage = "https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=1200&q=72",
  canonical,
  jsonLd,
  darkHero = false,
} = Astro.props;

const url = canonical ?? Astro.url.href;
const fullTitle = title.includes(SITE.name) ? title : `${title} · ${SITE.name}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary meta -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#075C4D" />

    <!-- Keywords -->
    <meta name="keywords" content="Care Veliyathunadu, Home for 1000 Rupees, charitable initiative Kerala, build a home donation, Malappuram NGO, community housing India" />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd ?? {
      "@context": "https://schema.org",
      "@type": "NGO",
      "name": SITE.name,
      "url": SITE.url,
      "logo": `${SITE.url}/logo.png`,
      "description": SITE.shortDesc,
      "email": SITE.email,
      "telephone": SITE.phone,
      "address": { "@type": "PostalAddress", "addressLocality": "Veliyathunadu", "addressRegion": "Kerala", "addressCountry": "IN" },
      "sameAs": Object.values(SITE.social),
    })}></script>

    <!-- Preconnect -->
    <link rel="preconnect" href="https://images.unsplash.com" />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-brand-500 focus:text-white focus:px-4 focus:py-2 focus:rounded-md">
      Skip to main content
    </a>
    <Header darkHero={darkHero} />
    <main id="main" class="flex-1 pt-[112px] md:pt-[120px]">
      <slot />
    </main>
    <Footer />

    <!-- Scroll-reveal observer + smooth in-page anchor focus -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("is-visible");
              observer.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
      );
      document.querySelectorAll(".reveal, .reveal-soft, .reveal-left, .reveal-right").forEach((el) => observer.observe(el));
    </script>
  </body>
</html>