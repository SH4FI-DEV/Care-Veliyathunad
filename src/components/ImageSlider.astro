---
interface Props {
  images: {
    src: string;
    alt: string;
  }[];
  autoPlay?: boolean;
  interval?: number;
}

const { images, autoPlay = true, interval = 5000 } = Astro.props;
---

<div class="image-slider relative w-full h-full overflow-hidden" data-autoplay={autoPlay} data-interval={interval}>
  <!-- Slides -->
  <div class="slider-track flex h-full" style="transition: transform 0.7s ease-in-out;">
    {images.map((img, i) => (
      <div class="slider-slide flex-shrink-0" style="min-width: 100%; height: 100%;">
        <img
          src={img.src}
          alt={img.alt}
          style="width: 100%; height: 100%; object-fit: cover;"
          loading={i === 0 ? "eager" : "lazy"}
        />
      </div>
    ))}
  </div>
  
  <!-- Navigation dots -->
  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex items-center gap-2 z-10">
    {images.map((_, i) => (
      <button
        class={`slider-dot w-3 h-3 rounded-full transition-all duration-300 ${i === 0 ? 'bg-white scale-100' : 'bg-white/50 scale-75'}`}
        data-index={i}
        aria-label={`Go to slide ${i + 1}`}
      />
    ))}
  </div>
  
  <!-- Navigation arrows -->
  <button class="slider-prev absolute left-4 top-1/2 -translate-y-1/2 w-10 h-10 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center text-white hover:bg-white/40 transition z-10" aria-label="Previous slide">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
  </button>
  <button class="slider-next absolute right-4 top-1/2 -translate-y-1/2 w-10 h-10 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center text-white hover:bg-white/40 transition z-10" aria-label="Next slide">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </button>
</div>

<style>
  .image-slider:hover .slider-prev,
  .image-slider:hover .slider-next {
    opacity: 1;
  }
  .slider-prev,
  .slider-next {
    opacity: 0;
    transition: opacity 0.3s ease;
  }
</style>

<script>
  class ImageSlider {
    private track: HTMLElement;
    private dots: NodeListOf<HTMLElement>;
    private prevBtn: HTMLElement;
    private nextBtn: HTMLElement;
    private currentIndex: number = 0;
    private totalSlides: number;
    private autoPlay: boolean;
    private interval: number;
    private timer: number | null = null;
    private isPaused: boolean = false;

    constructor(el: HTMLElement) {
      this.track = el.querySelector('.slider-track')!;
      this.dots = el.querySelectorAll('.slider-dot');
      this.prevBtn = el.querySelector('.slider-prev')!;
      this.nextBtn = el.querySelector('.slider-next')!;
      this.totalSlides = this.dots.length;
      this.autoPlay = el.dataset.autoplay === 'true';
      this.interval = parseInt(el.dataset.interval || '5000');

      this.init();
    }

    init() {
      // Dot navigation
      this.dots.forEach((dot, i) => {
        dot.addEventListener('click', () => this.goTo(i));
      });

      // Arrow navigation
      this.prevBtn.addEventListener('click', () => this.prev());
      this.nextBtn.addEventListener('click', () => this.next());

      // Pause on hover
      const container = this.track.closest('.image-slider')!;
      container.addEventListener('mouseenter', () => {
        this.isPaused = true;
        this.stopAutoPlay();
      });
      container.addEventListener('mouseleave', () => {
        this.isPaused = false;
        if (this.autoPlay) this.startAutoPlay();
      });

      // Start autoplay
      if (this.autoPlay) this.startAutoPlay();
    }

    goTo(index: number) {
      this.currentIndex = index;
      this.track.style.transform = `translateX(-${index * 100}%)`;
      this.updateDots();
    }

    next() {
      this.currentIndex = (this.currentIndex + 1) % this.totalSlides;
      this.goTo(this.currentIndex);
    }

    prev() {
      this.currentIndex = (this.currentIndex - 1 + this.totalSlides) % this.totalSlides;
      this.goTo(this.currentIndex);
    }

    updateDots() {
      this.dots.forEach((dot, i) => {
        if (i === this.currentIndex) {
          dot.classList.add('bg-white', 'scale-100');
          dot.classList.remove('bg-white/50', 'scale-75');
        } else {
          dot.classList.remove('bg-white', 'scale-100');
          dot.classList.add('bg-white/50', 'scale-75');
        }
      });
    }

    startAutoPlay() {
      this.timer = window.setInterval(() => {
        if (!this.isPaused) this.next();
      }, this.interval);
    }

    stopAutoPlay() {
      if (this.timer) {
        clearInterval(this.timer);
        this.timer = null;
      }
    }
  }

  // Initialize all sliders
  document.querySelectorAll('.image-slider').forEach((el) => {
    new ImageSlider(el as HTMLElement);
  });
</script>
