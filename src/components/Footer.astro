---
import { NAV, SITE } from "../data/site";
import Icon from "./Icon.astro";
---
<footer class="bg-brand-600 text-cream-50 pt-20 pb-10 mt-auto">
  <div class="container-x">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12">

      <!-- Brand block -->
      <div class="md:col-span-5">
        <a href="/" class="flex items-center gap-3 mb-5">
          <span class="inline-flex items-center justify-center w-10 h-10 rounded-md bg-white/10">
            <Icon name="home" size={20} class="text-saffron-300" />
          </span>
          <span class="flex flex-col leading-tight">
            <span class="font-display text-xl">{SITE.shortName}</span>
            <span class="text-[11px] uppercase tracking-[0.14em] text-cream-100/70">{SITE.brandLine}</span>
          </span>
        </a>
        <p class="text-cream-100/80 text-[15px] leading-relaxed max-w-md">
          {SITE.shortDesc}
        </p>
        <div class="mt-6 flex items-center gap-2">
          <a href={SITE.social.facebook}  aria-label="Facebook"  class="social-icon"><Icon name="facebook"  size={16} /></a>
          <a href={SITE.social.instagram} aria-label="Instagram" class="social-icon"><Icon name="instagram" size={16} /></a>
          <a href={SITE.social.youtube}   aria-label="YouTube"   class="social-icon"><Icon name="youtube"   size={16} /></a>
          <a href={SITE.social.whatsapp}  aria-label="WhatsApp"  class="social-icon"><Icon name="whatsapp"  size={16} /></a>
        </div>
      </div>

      <!-- Quick links -->
      <div class="md:col-span-3">
        <h3 class="footer-heading">Explore</h3>
        <ul class="space-y-2.5">
          {NAV.map((item) => (
            <li><a href={item.href} class="footer-link">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div class="md:col-span-4">
        <h3 class="footer-heading">Reach us</h3>
        <ul class="space-y-3 text-cream-100/80 text-[15px]">
          <li class="flex items-start gap-3">
            <Icon name="map-pin" size={16} class="text-saffron-300 mt-0.5 flex-shrink-0" />
            <span>{SITE.address}</span>
          </li>
          <li class="flex items-start gap-3">
            <Icon name="phone" size={16} class="text-saffron-300 mt-0.5 flex-shrink-0" />
            <a href={`tel:${SITE.phone}`} class="footer-link !text-cream-100/80 hover:!text-saffron-300">{SITE.phone}</a>
          </li>
          <li class="flex items-start gap-3">
            <Icon name="mail" size={16} class="text-saffron-300 mt-0.5 flex-shrink-0" />
            <a href={`mailto:${SITE.email}`} class="footer-link !text-cream-100/80 hover:!text-saffron-300">{SITE.email}</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bank details strip -->
    <div class="mt-14 pt-8 border-t border-white/10">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-5 text-sm text-cream-100/75">
          <span class="flex items-center gap-2">
            <Icon name="bank" size={15} class="text-saffron-300" />
            {SITE.bank.accountName}
          </span>
          <span class="hidden sm:inline text-white/30">·</span>
          <span>A/C <span class="font-mono text-saffron-300">{SITE.bank.accountNumber}</span></span>
          <span class="hidden sm:inline text-white/30">·</span>
          <span>IFSC <span class="font-mono text-saffron-300">{SITE.bank.ifsc}</span></span>
        </div>
        <a href="/contact#donate" class="btn-saffron !py-2.5 !px-4 !text-sm self-start lg:self-auto">
          Support a Home
        </a>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-white/10 flex flex-col sm:flex-row justify-between gap-3 text-xs text-cream-100/55">
      <p>© {new Date().getFullYear()} {SITE.shortName}. Built with the community.</p>
      <p>Veliyathunadu, Kerala</p>
    </div>
  </div>
</footer>

<style>
  .footer-heading {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1rem;
    margin-bottom: 1rem;
    color: #fff;
  }
  .footer-link {
    color: rgba(255, 253, 252, 0.78);
    transition: color 0.2s ease;
    font-size: 0.95rem;
  }
  .footer-link:hover { color: var(--color-saffron-300); }
  .social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    transition: all 0.2s ease;
  }
  .social-icon:hover {
    background: var(--color-saffron-300);
    color: var(--color-ink-900);
  }
</style>