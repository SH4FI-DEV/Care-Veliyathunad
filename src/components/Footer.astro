---
import { NAV, SITE } from "../data/site";
import Icon from "./Icon.astro";
---
<footer class="bg-brand-900 text-cream-50 mt-auto">
  <div class="container-x py-16 md:py-20">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12">

      <!-- Brand block -->
      <div class="md:col-span-5">
        <a href="/" class="flex items-center gap-2.5 mb-5">
          <span class="inline-flex items-center justify-center w-8 h-8 rounded-md bg-white/10">
            <Icon name="home" size={16} class="text-amber-400" />
          </span>
          <span class="font-display text-[1.05rem] text-cream-50">{SITE.shortName}</span>
        </a>
        <p class="text-cream-100/70 text-[15px] leading-[1.7] max-w-md mb-6">
          {SITE.shortDesc}
        </p>
        <div class="flex items-center gap-2">
          <a href={SITE.social.facebook}  aria-label="Facebook"  class="social-icon"><Icon name="facebook"  size={15} /></a>
          <a href={SITE.social.instagram} aria-label="Instagram" class="social-icon"><Icon name="instagram" size={15} /></a>
          <a href={SITE.social.youtube}   aria-label="YouTube"   class="social-icon"><Icon name="youtube"   size={15} /></a>
          <a href={SITE.social.whatsapp}  aria-label="WhatsApp"  class="social-icon"><Icon name="whatsapp"  size={15} /></a>
        </div>
      </div>

      <!-- Quick links -->
      <div class="md:col-span-3">
        <h3 class="footer-heading">Explore</h3>
        <ul class="space-y-2.5">
          {NAV.map((item) => (
            <li><a href={item.href} class="footer-link">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div class="md:col-span-4">
        <h3 class="footer-heading">Reach us</h3>
        <ul class="space-y-3 text-cream-100/70 text-[15px]">
          <li class="flex items-start gap-3">
            <Icon name="map-pin" size={15} class="text-amber-400 mt-0.5 flex-shrink-0" />
            <span>{SITE.address}</span>
          </li>
          <li class="flex items-start gap-3">
            <Icon name="phone" size={15} class="text-amber-400 mt-0.5 flex-shrink-0" />
            <a href={`tel:${SITE.phone}`} class="footer-link !text-cream-100/70 hover:!text-amber-400">{SITE.phone}</a>
          </li>
          <li class="flex items-start gap-3">
            <Icon name="mail" size={15} class="text-amber-400 mt-0.5 flex-shrink-0" />
            <a href={`mailto:${SITE.email}`} class="footer-link !text-cream-100/70 hover:!text-amber-400">{SITE.email}</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-14 pt-8 border-t border-white/10 flex flex-col sm:flex-row justify-between gap-3 text-xs text-cream-100/45">
      <p>&copy; {new Date().getFullYear()} {SITE.shortName}. Built with the community.</p>
      <p>Veliyathunadu, Kerala</p>
    </div>
  </div>
</footer>

<style>
  .footer-heading {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1rem;
    margin-bottom: 1rem;
    color: var(--color-cream-50);
  }
  .footer-link {
    color: rgba(255, 253, 252, 0.70);
    transition: color 0.2s ease;
    font-size: 0.95rem;
  }
  .footer-link:hover { color: var(--color-amber-400); }
  .social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.07);
    color: rgba(255, 253, 252, 0.70);
    transition: color 0.2s ease, background 0.2s ease;
  }
  .social-icon:hover {
    color: var(--color-amber-400);
    background: rgba(255, 255, 255, 0.12);
  }
</style>
