---
import { NAV, SITE } from "../data/site";
import Icon from "./Icon.astro";

interface Props {
  darkHero?: boolean;
}
const { darkHero = false } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class={`site-header ${darkHero ? "has-dark-hero" : ""}`} id="siteHeader">
  <div class="nav-bar" id="navBar">
    <div class="container-x">
      <div class="flex items-center justify-between h-16 md:h-[72px]">

        <!-- Logo — compact -->
        <a href="/" class="flex items-center gap-2.5 group" aria-label={`${SITE.shortName} home`}>
          <span class="logo-mark">
            <Icon name="home" size={16} class="text-white" />
          </span>
          <span class="font-display text-[1rem] md:text-[1.05rem] text-ink-900">
            {SITE.shortName}
          </span>
        </a>

        <!-- Desktop nav -->
        <nav class="hidden lg:flex items-center gap-1" aria-label="Primary">
          {NAV.map((item) => {
            const active = item.href === "/" ? currentPath === "/" : currentPath.startsWith(item.href);
            return (
              <a
                href={item.href}
                class={`nav-menu-link ${active ? "is-active" : ""}`}
              >
                {item.label}
              </a>
            );
          })}
        </nav>

        <!-- Desktop CTA — small, yellow -->
        <div class="hidden lg:flex items-center">
          <a href="/contact#donate" class="btn-primary !h-10 !px-5 !text-[13px]">
            Support a Home
            <Icon name="arrow-right" size={14} />
          </a>
        </div>

        <!-- Mobile hamburger -->
        <button
          id="navToggle"
          class="lg:hidden inline-flex items-center justify-center w-9 h-9 text-ink-900"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
        >
          <Icon name="menu" size={20} class="block" id="iconMenu" />
          <Icon name="x" size={20} class="hidden" id="iconClose" />
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile drawer — cream background, editorial -->
  <div id="mobileDrawer" class="lg:hidden fixed inset-0 bg-cream-50 z-40 opacity-0 pointer-events-none transition-opacity duration-300">
    <div class="container-x pt-8 pb-12 h-full overflow-y-auto">
      <nav class="flex flex-col gap-1" aria-label="Mobile">
        {NAV.map((item) => {
          const active = item.href === "/" ? currentPath === "/" : currentPath.startsWith(item.href);
          return (
            <a
              href={item.href}
              class={`mobile-nav-link flex items-center justify-between text-2xl font-display py-3.5 border-b border-cream-200 ${active ? "text-brand-500" : "text-ink-900"}`}
            >
              {item.label}
              <Icon name="arrow-right" size={18} />
            </a>
          );
        })}
      </nav>
      <div class="mt-8">
        <a href="/contact#donate" class="btn-primary w-full">
          <Icon name="heart" size={15} />
          Support a Home
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
  }

  /* Main nav bar — cream, minimal, editorial */
  .nav-bar {
    background: var(--color-cream-50);
    border-bottom: 1px solid var(--color-cream-200);
    transition: box-shadow 0.25s ease;
  }

  /* On scroll — subtle shadow only */
  .site-header.is-scrolled .nav-bar {
    box-shadow: 0 1px 8px -4px rgba(23, 60, 52, 0.10);
  }

  /* Dark hero: nav is transparent over the hero, becomes solid cream on scroll */
  .site-header.has-dark-hero .nav-bar {
    background: transparent;
    border-bottom-color: transparent;
  }
  .site-header.has-dark-hero .nav-bar .nav-menu-link,
  .site-header.has-dark-hero .nav-bar .font-display {
    color: white;
  }
  .site-header.has-dark-hero .nav-bar .nav-menu-link.is-active {
    color: var(--color-amber-400);
  }
  .site-header.has-dark-hero .nav-bar .btn-primary {
    background: var(--color-amber-400);
    color: var(--color-ink-900);
  }
  .site-header.has-dark-hero.is-scrolled .nav-bar {
    background: var(--color-cream-50);
    border-bottom-color: var(--color-cream-200);
  }
  .site-header.has-dark-hero.is-scrolled .nav-bar .nav-menu-link,
  .site-header.has-dark-hero.is-scrolled .nav-bar .font-display {
    color: var(--color-ink-900);
  }
  .site-header.has-dark-hero.is-scrolled .nav-bar .nav-menu-link.is-active {
    color: var(--color-brand-500);
  }

  /* Nav menu link */
  .nav-menu-link {
    position: relative;
    font-family: var(--font-sans);
    padding: 8px 14px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink-700);
    transition: color 0.2s ease;
    display: inline-flex;
    align-items: center;
  }
  .nav-menu-link:hover { color: var(--color-ink-900); }
  .nav-menu-link.is-active {
    color: var(--color-brand-500);
    font-weight: 600;
  }

  /* Logo mark — smaller, editorial */
  .logo-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: var(--color-brand-500);
    flex-shrink: 0;
  }

  /* Mobile drawer */
  #mobileDrawer.is-open { opacity: 1; pointer-events: auto; }
</style>

<script>
  const header = document.getElementById("siteHeader");
  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 24) header.classList.add("is-scrolled");
    else header.classList.remove("is-scrolled");
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  const toggle = document.getElementById("navToggle");
  const drawer = document.getElementById("mobileDrawer");
  const iconMenu = document.getElementById("iconMenu");
  const iconClose = document.getElementById("iconClose");
  toggle?.addEventListener("click", () => {
    const open = drawer?.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", String(open));
    iconMenu?.classList.toggle("hidden", !!open);
    iconMenu?.classList.toggle("block", !open);
    iconClose?.classList.toggle("block", !!open);
    iconClose?.classList.toggle("hidden", !open);
    document.body.style.overflow = open ? "hidden" : "";
  });
  document.querySelectorAll(".mobile-nav-link").forEach((a) => {
    a.addEventListener("click", () => toggle?.click());
  });
</script>
