---
import Icon from "./Icon.astro";

interface Testimonial {
  quote: string;
  name: string;
  designation: string;
  photo: string;
  verified: boolean;
}

interface Props {
  testimonials: Testimonial[];
  autoPlay?: boolean;
  interval?: number;
}

const { testimonials, autoPlay = true, interval = 6000 } = Astro.props;
---

<div class="testimonial-carousel relative" data-autoplay={autoPlay} data-interval={interval}>
  <!-- Slides container -->
  <div class="overflow-hidden">
    <div class="carousel-track flex transition-transform duration-700 ease-in-out">
      {testimonials.filter(t => t.verified).map((t) => (
        <div class="carousel-slide min-w-full px-4">
          <div class="max-w-4xl mx-auto text-center">
            <!-- Quote icon -->
            <div class="mb-8">
              <svg class="w-12 h-12 mx-auto text-brand-200" fill="currentColor" viewBox="0 0 24 24">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
              </svg>
            </div>
            
            <!-- Quote text -->
            <blockquote class="font-display text-[1.4rem] sm:text-[1.8rem] md:text-[2.2rem] leading-[1.3] text-ink-900 mb-10 italic">
              "{t.quote}"
            </blockquote>
            
            <!-- Author info -->
            <div class="flex items-center justify-center gap-4">
              <div class="w-14 h-14 rounded-full overflow-hidden bg-cream-200">
                <img
                  src={t.photo}
                  alt={t.name}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
              <div class="text-left">
                <p class="font-sans font-semibold text-ink-900 text-[15px]">{t.name}</p>
                <p class="font-sans text-ink-500 text-[13px]">{t.designation}</p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
  
  <!-- Navigation arrows -->
  <button class="carousel-prev absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 w-12 h-12 bg-white shadow-lg rounded-full flex items-center justify-center text-ink-700 hover:bg-cream-100 transition z-10 hidden md:flex" aria-label="Previous testimonial">
    <Icon name="chevron-left" size={20} />
  </button>
  <button class="carousel-next absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 w-12 h-12 bg-white shadow-lg rounded-full flex items-center justify-center text-ink-700 hover:bg-cream-100 transition z-10 hidden md:flex" aria-label="Next testimonial">
    <Icon name="chevron-right" size={20} />
  </button>
  
  <!-- Dots -->
  <div class="flex justify-center gap-3 mt-10">
    {testimonials.filter(t => t.verified).map((_, i) => (
      <button
        class={`carousel-dot w-2.5 h-2.5 rounded-full transition-all duration-300 ${i === 0 ? 'bg-brand-500 scale-100' : 'bg-ink-300 scale-75'}`}
        data-index={i}
        aria-label={`Go to testimonial ${i + 1}`}
      />
    ))}
  </div>
</div>

<script>
  class TestimonialCarousel {
    private track: HTMLElement;
    private dots: NodeListOf<HTMLElement>;
    private prevBtn: HTMLElement | null;
    private nextBtn: HTMLElement | null;
    private currentIndex: number = 0;
    private totalSlides: number;
    private autoPlay: boolean;
    private interval: number;
    private timer: number | null = null;
    private isPaused: boolean = false;

    constructor(el: HTMLElement) {
      this.track = el.querySelector('.carousel-track')!;
      this.dots = el.querySelectorAll('.carousel-dot');
      this.prevBtn = el.querySelector('.carousel-prev');
      this.nextBtn = el.querySelector('.carousel-next');
      this.totalSlides = this.dots.length;
      this.autoPlay = el.dataset.autoplay === 'true';
      this.interval = parseInt(el.dataset.interval || '6000');

      this.init();
    }

    init() {
      // Arrow navigation
      this.prevBtn?.addEventListener('click', () => {
        this.prev();
        this.resetAutoPlay();
      });
      this.nextBtn?.addEventListener('click', () => {
        this.next();
        this.resetAutoPlay();
      });

      // Dot navigation
      this.dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          this.goTo(i);
          this.resetAutoPlay();
        });
      });

      // Pause on hover
      const container = this.track.closest('.testimonial-carousel')!;
      container.addEventListener('mouseenter', () => {
        this.isPaused = true;
        this.stopAutoPlay();
      });
      container.addEventListener('mouseleave', () => {
        this.isPaused = false;
        if (this.autoPlay) this.startAutoPlay();
      });

      // Touch/swipe support
      let startX = 0;
      let isDragging = false;

      this.track.addEventListener('touchstart', (e) => {
        startX = e.touches[0].clientX;
        isDragging = true;
      });

      this.track.addEventListener('touchmove', (e) => {
        if (!isDragging) return;
        const diff = startX - e.touches[0].clientX;
        if (Math.abs(diff) > 50) {
          if (diff > 0) this.next();
          else this.prev();
          isDragging = false;
          this.resetAutoPlay();
        }
      });

      this.track.addEventListener('touchend', () => {
        isDragging = false;
      });

      // Start autoplay
      if (this.autoPlay) this.startAutoPlay();
    }

    goTo(index: number) {
      this.currentIndex = index;
      this.track.style.transform = `translateX(-${index * 100}%)`;
      this.updateDots();
    }

    next() {
      this.currentIndex = (this.currentIndex + 1) % this.totalSlides;
      this.goTo(this.currentIndex);
    }

    prev() {
      this.currentIndex = (this.currentIndex - 1 + this.totalSlides) % this.totalSlides;
      this.goTo(this.currentIndex);
    }

    updateDots() {
      this.dots.forEach((dot, i) => {
        if (i === this.currentIndex) {
          dot.classList.add('bg-brand-500', 'scale-100');
          dot.classList.remove('bg-ink-300', 'scale-75');
        } else {
          dot.classList.remove('bg-brand-500', 'scale-100');
          dot.classList.add('bg-ink-300', 'scale-75');
        }
      });
    }

    startAutoPlay() {
      this.timer = window.setInterval(() => {
        if (!this.isPaused) this.next();
      }, this.interval);
    }

    stopAutoPlay() {
      if (this.timer) {
        clearInterval(this.timer);
        this.timer = null;
      }
    }

    resetAutoPlay() {
      this.stopAutoPlay();
      if (this.autoPlay) this.startAutoPlay();
    }
  }

  // Initialize all testimonial carousels
  document.querySelectorAll('.testimonial-carousel').forEach((el) => {
    new TestimonialCarousel(el as HTMLElement);
  });
</script>
