---
import Icon from "./Icon.astro";
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: "left" | "center";
  light?: boolean;
  kicker?: string;
}
const { eyebrow, title, subtitle, align = "left", light = false, kicker } = Astro.props;
const titleColor = light ? "text-cream-50" : "text-ink-900";
const subColor   = light ? "text-cream-100/80" : "text-ink-500";
const alignClass = align === "center" ? "text-center mx-auto" : "text-left";
---
<div class={`max-w-2xl ${alignClass}`}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 class={`heading-display mt-3 text-[2.4rem] sm:text-[2.7rem] md:text-[3.1rem] lg:text-[3.4rem] ${titleColor}`}>
    {title}
  </h2>
  {kicker && <p class={`mt-3 text-lg italic font-display ${light ? "text-cream-100/80" : "text-ink-700"}`}>{kicker}</p>}
  {subtitle && <p class={`mt-4 text-[16px] md:text-[17px] leading-[1.7] ${subColor}`}>{subtitle}</p>}
</div>