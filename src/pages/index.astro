---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import ImageMarquee from "../components/ImageMarquee.astro";
import { SITE, IMPACT } from "../data/site";
import { PROJECTS, COUNTS } from "../data/projects";
import { TESTIMONIALS } from "../data/faqs";
import { IMAGE_POOL, unsplash } from "../data/images";

const DELIVERED = PROJECTS.filter((p) => p.status === "delivered");
const LATEST_PROJECT = DELIVERED.slice(-1)[0];
const NEXT_HOME = PROJECTS.find((p) => p.status === "in-progress");

void IMPACT;
---

<Layout
  title="Building Homes. Building Hope."
  description="Care Veliyathunadu builds simple, dignified homes for families in need in Veliyathunadu, Kerala. With contributions of ₹1,000 from anyone who wishes to be part of the work."
  darkHero={true}
>

  <!-- ============================================================
       1. HERO BANNER
       ============================================================ -->
  <section class="hero-section-editorial relative overflow-hidden">
    <div class="absolute inset-0">
      <img
        src={unsplash(IMAGE_POOL.HOME_RURAL_01, 1920, 75)}
        alt="A new home built by Care Veliyathunadu in rural Kerala"
        class="w-full h-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-black/10"></div>
    </div>
    <div class="relative z-10 container-x flex flex-col justify-end min-h-[85vh] md:min-h-[90vh] pb-16 md:pb-24">
      <div class="max-w-2xl reveal">
        <p class="text-amber-400 text-xs sm:text-sm uppercase tracking-[0.2em] font-semibold mb-5">
          Building Homes, Building Hope
        </p>
        <h1 class="font-display text-white text-[clamp(2.5rem,6vw,5rem)] leading-[1.02] tracking-tight mb-6">
          A Home Is More<br/>Than Four Walls.
        </h1>
        <p class="text-white/80 text-[17px] md:text-[18px] leading-[1.7] max-w-lg mb-8">
          We build simple, dignified homes for families in Veliyathunadu, Kerala, with contributions of ₹1,000 from anyone who wishes to be part of the work.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/contact#donate" class="btn-primary">
            Support a Home
            <Icon name="arrow-right" size={16} />
          </a>
          <a href="/about" class="inline-flex items-center gap-2 text-white border border-white/25 hover:border-white/50 px-6 py-3 rounded-md font-semibold text-[14px] transition-all duration-200">
            Learn More
            <Icon name="arrow-right" size={14} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       2. WHO WE ARE — Image + text + stats + about button
       ============================================================ -->
  <section class="section-y bg-cream-50">
    <div class="container-x">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <div class="lg:col-span-5 reveal">
          <div class="overflow-hidden rounded-xl">
            <img
              src={unsplash(IMAGE_POOL.HOME_SIMPLE_03, 800, 80)}
              alt="Community building a home together in Kerala"
              class="w-full aspect-[4/5] object-cover"
              loading="lazy"
            />
          </div>
        </div>
        <div class="lg:col-span-7">
          <p class="eyebrow mb-5">Who We Are</p>
          <h2 class="font-display text-[clamp(2rem,4vw,3.2rem)] leading-[1.08] text-ink-900 mb-6">
            A Small Group of Neighbours<br/>Who Decided to Act.
          </h2>
          <p class="text-ink-700 text-[17px] leading-[1.8] mb-4">
            Care Veliyathunadu is a community initiative based in Veliyathunadu, Kerala. We do one thing: we help build simple, dignified homes for families in our area who need one, together with the neighbours, masons, and contributors who make the work possible.
          </p>
          <p class="text-ink-700 text-[17px] leading-[1.8] mb-10">
            Since 2021, what started with one neighbour's contribution has grown into a movement of hundreds working together.
          </p>

          <!-- Stats -->
          <div class="grid grid-cols-3 gap-6 md:gap-8 py-8 px-6 md:px-8 bg-cream-100 rounded-xl mb-8 reveal">
            <div class="text-center">
              <div class="font-display text-[clamp(1.8rem,3vw,2.8rem)] leading-none text-ink-900 mb-1">
                <span class="counter-value" data-end={COUNTS.homesDelivered} data-suffix="+" data-duration="2000">0</span>
              </div>
              <div class="text-xs md:text-sm text-ink-500 font-medium">Homes Built</div>
            </div>
            <div class="text-center border-x border-cream-200">
              <div class="font-display text-[clamp(1.8rem,3vw,2.8rem)] leading-none text-ink-900 mb-1">
                <span class="counter-value" data-end={COUNTS.totalBeneficiaries} data-suffix="+" data-duration="2000">0</span>
              </div>
              <div class="text-xs md:text-sm text-ink-500 font-medium">Lives Changed</div>
            </div>
            <div class="text-center">
              <div class="font-display text-[clamp(1.8rem,3vw,2.8rem)] leading-none text-ink-900 mb-1">
                <span class="counter-value" data-end={COUNTS.totalContributors} data-suffix="+" data-duration="2000">0</span>
              </div>
              <div class="text-xs md:text-sm text-ink-500 font-medium">Contributors</div>
            </div>
          </div>

          <a href="/about" class="btn-primary">
            About Us
            <Icon name="arrow-right" size={16} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       3. FEATURED / LATEST PROJECT
       ============================================================ -->
  {LATEST_PROJECT && (
    <section class="section-y bg-cream-100">
      <div class="container-x">
        <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          <div class="lg:col-span-7 reveal">
            <div class="overflow-hidden rounded-xl">
              <img
                src={LATEST_PROJECT.cover}
                alt={LATEST_PROJECT.familyName}
                class="w-full aspect-[16/10] object-cover"
                loading="lazy"
              />
            </div>
          </div>
          <div class="lg:col-span-5 reveal">
            <p class="eyebrow mb-4">Latest Project</p>
            <span class="inline-block text-xs uppercase tracking-[0.14em] font-semibold text-brand-500 bg-brand-50 px-3 py-1 rounded-full mb-4">
              Completed
            </span>
            <h2 class="font-display text-[clamp(1.8rem,3.5vw,2.8rem)] leading-[1.08] text-ink-900 mb-4">
              {LATEST_PROJECT.familyName}
            </h2>
            <div class="flex items-center gap-4 text-sm text-ink-500 mb-5">
              <span class="flex items-center gap-1.5">
                <Icon name="map-pin" size={14} />
                {LATEST_PROJECT.location}, {LATEST_PROJECT.district}
              </span>
              <span class="flex items-center gap-1.5">
                <Icon name="users" size={14} />
                {LATEST_PROJECT.beneficiaries} members
              </span>
            </div>
            <p class="text-ink-700 text-[16px] leading-[1.7] mb-8">
              {LATEST_PROJECT.short}
            </p>
            <a href={`/projects/${LATEST_PROJECT.slug}`} class="btn-primary">
              Read Their Story
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ============================================================
       4. FAMILIES / PROJECTS — Cards with image, info, button
       ============================================================ -->
  <section class="section-y bg-cream-50">
    <div class="container-x">
      <div class="text-center mb-14 reveal">
        <p class="eyebrow justify-center mb-5">Our Projects</p>
        <h2 class="font-display text-[clamp(2rem,4vw,3.2rem)] leading-[1.08] text-ink-900 mb-4">
          Families We Have Helped<br/>Build Homes For.
        </h2>
        <p class="text-ink-700 text-[17px] leading-[1.7] max-w-2xl mx-auto">
          Each card below represents a family, a story, and a home that was built together by the community.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {DELIVERED.map((project, i) => (
          <div class="bg-cream-50 border border-cream-200 rounded-xl overflow-hidden group reveal" style={`animation-delay: ${i * 80}ms`}>
            <div class="aspect-[16/10] overflow-hidden">
              <img
                src={project.cover}
                alt={project.familyName}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <div class="p-6">
              <div class="flex items-center gap-3 mb-3">
                <span class="text-xs uppercase tracking-[0.12em] font-semibold text-brand-500 bg-brand-50 px-2.5 py-0.5 rounded-full">
                  Home #{project.number}
                </span>
                <span class="text-xs text-ink-500 flex items-center gap-1">
                  <Icon name="map-pin" size={12} />
                  {project.location}
                </span>
              </div>
              <h3 class="font-display text-[1.25rem] leading-[1.15] text-ink-900 mb-2">
                {project.familyName}
              </h3>
              <p class="text-ink-700 text-[14px] leading-[1.65] mb-4 line-clamp-2">
                {project.short}
              </p>
              <div class="flex items-center gap-4 text-xs text-ink-500 mb-5 pt-4 border-t border-cream-200">
                <span class="flex items-center gap-1.5">
                  <Icon name="users" size={13} />
                  {project.beneficiaries} members
                </span>
                <span class="flex items-center gap-1.5">
                  <Icon name="people" size={13} />
                  {project.contributors} contributors
                </span>
              </div>
              <a href={`/projects/${project.slug}`} class="btn-tertiary text-[13px]">
                Read their story
                <Icon name="arrow-right" size={14} />
              </a>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center mt-12 reveal">
        <a href="/projects" class="btn-secondary">
          View All Projects
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       5. HOW IT WORKS — Fund allocation breakdown
       ============================================================ -->
  <section class="section-y bg-cream-100">
    <div class="container-x">
      <div class="text-center mb-14 reveal">
        <p class="eyebrow justify-center mb-5">How It Works</p>
        <h2 class="font-display text-[clamp(2rem,4vw,3.2rem)] leading-[1.08] text-ink-900 mb-4">
          Where Your Fund Goes.
        </h2>
        <p class="text-ink-700 text-[17px] leading-[1.7] max-w-2xl mx-auto">
          Every contribution is tracked and spent on building materials and local labour. Here&rsquo;s how approximately ₹4,00,000 is allocated per home.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl mx-auto">
        {[
          { icon: "shield", label: "Cement & Concrete", percent: "35%", amount: "~₹1,40,000", desc: "Foundation, walls, and structural work" },
          { icon: "home", label: "Roofing & Doors", percent: "25%", amount: "~₹1,00,000", desc: "Steel roof trusses, sheets, doors, and windows" },
          { icon: "coin", label: "Bricks & Materials", percent: "25%", amount: "~₹1,00,000", desc: "Laterite bricks, sand, gravel, and wiring" },
          { icon: "users", label: "Skilled Labour", percent: "15%", amount: "~₹60,000", desc: "Masons, carpenters, and electricians" },
        ].map((item, i) => (
          <div class="bg-cream-50 border border-cream-200 rounded-xl p-6 text-center reveal" style={`animation-delay: ${i * 100}ms`}>
            <div class="w-12 h-12 rounded-full bg-brand-50 flex items-center justify-center mx-auto mb-4">
              <Icon name={item.icon} size={20} class="text-brand-500" />
            </div>
            <div class="font-display text-amber-400 text-[1.5rem] mb-1">{item.percent}</div>
            <h3 class="font-semibold text-ink-900 text-[15px] mb-1">{item.label}</h3>
            <p class="text-ink-500 text-xs mb-2">{item.amount}</p>
            <p class="text-ink-700 text-[13px] leading-[1.6]">{item.desc}</p>
          </div>
        ))}
      </div>

      <div class="text-center mt-10 reveal">
        <p class="text-ink-500 text-sm">
          Contributing just <strong class="text-ink-900">₹1,000</strong> gets you listed as a contributor. The receipt is valid for <strong class="text-ink-900">80G tax exemption</strong>.
        </p>
      </div>
    </div>
  </section>

  <!-- ============================================================
       6. TESTIMONIALS — Twitter-style white card carousel
       ============================================================ -->
  <section class="section-y bg-cream-50 overflow-hidden">
    <div class="container-x">
      <div class="text-center mb-14 reveal">
        <p class="eyebrow justify-center mb-5">Testimonials</p>
        <h2 class="font-display text-[clamp(2rem,4vw,3.2rem)] leading-[1.08] text-ink-900">
          What People Are Saying.
        </h2>
      </div>
    </div>

    <div class="testimonial-marquee-wrapper">
      <div class="testimonial-marquee">
        {[...TESTIMONIALS, ...TESTIMONIALS].map((t) => (
          <div class="testimonial-card">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-full bg-brand-50 flex items-center justify-center text-brand-500 font-bold text-sm flex-shrink-0">
                {t.name.charAt(0)}
              </div>
              <div class="min-w-0">
                <p class="font-semibold text-ink-900 text-[14px] leading-tight truncate">{t.name}</p>
                <p class="text-ink-500 text-[12px] truncate">{t.designation}</p>
              </div>
            </div>
            <p class="text-ink-700 text-[14px] leading-[1.65]">
              &ldquo;{t.quote}&rdquo;
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       7. CTA — Support section
       ============================================================ -->
  <section class="section-y" style="background: #F8C62F;">
    <div class="container-x text-center">
      <div class="max-w-2xl mx-auto reveal">
        <p class="text-ink-900/60 text-xs uppercase tracking-[0.2em] font-semibold mb-5">
          {NEXT_HOME ? `Currently Building: ${NEXT_HOME.familyName}` : "Join the Work"}
        </p>
        <h2 class="font-display text-ink-900 text-[clamp(2rem,5vw,3.5rem)] leading-[1.05] mb-6">
          Every Home Begins<br/>With One Act of Kindness.
        </h2>
        <p class="text-ink-900/80 text-[17px] leading-[1.7] max-w-lg mx-auto mb-10">
          Your ₹1,000 contribution joins you to the people who are building a home for a family in need. Every brick, every wall, every roof — built together.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/contact#donate" class="inline-flex items-center gap-2 bg-ink-900 text-cream-50 px-7 py-3.5 rounded-md font-bold text-[14px] hover:bg-ink-900/90 transition-colors">
            Support a Home
            <Icon name="arrow-right" size={15} />
          </a>
          <a href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-white text-ink-900 px-7 py-3.5 rounded-md font-bold text-[14px] hover:bg-white/90 transition-colors">
            <Icon name="whatsapp" size={15} />
            Talk to Us
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       8. MOVING GALLERY CAROUSEL
       ============================================================ -->
  <section class="py-16 bg-cream-50">
    <div class="container-x mb-8">
      <p class="eyebrow justify-center reveal">Behind the Scenes</p>
    </div>
    <ImageMarquee
      images={[
        { src: unsplash(IMAGE_POOL.BUILDING_01, 700), alt: "Construction work", caption: "Foundation work" },
        { src: unsplash(IMAGE_POOL.VOLUNTEER_01, 700), alt: "Volunteers", caption: "Community volunteers" },
        { src: unsplash(IMAGE_POOL.HOME_RURAL_01, 700), alt: "Completed home", caption: "Home #1 Complete" },
        { src: unsplash(IMAGE_POOL.CONSTRUCTION_01, 700), alt: "Building", caption: "Raising the walls" },
        { src: unsplash(IMAGE_POOL.HANDOVER_04, 700), alt: "Handover", caption: "Key handover ceremony" },
        { src: unsplash(IMAGE_POOL.HOME_SIMPLE_03, 700), alt: "New home", caption: "A new beginning" },
      ]}
      speed={35}
    />
  </section>

</Layout>

<style>
  .hero-section-editorial {
    min-height: 85vh;
    display: flex;
    align-items: stretch;
  }
  @media (min-width: 768px) {
    .hero-section-editorial { min-height: 90vh; }
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Testimonial marquee */
  .testimonial-marquee-wrapper {
    overflow: hidden;
    width: 100%;
  }
  .testimonial-marquee {
    display: flex;
    gap: 24px;
    animation: testimonialScroll 40s linear infinite;
    width: max-content;
  }
  .testimonial-marquee:hover {
    animation-play-state: paused;
  }
  .testimonial-card {
    flex-shrink: 0;
    width: 360px;
    background: white;
    border: 1px solid var(--color-cream-200);
    border-radius: 12px;
    padding: 24px;
  }
  @keyframes testimonialScroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .testimonial-marquee { animation: none; }
  }
  @media (max-width: 640px) {
    .testimonial-card { width: 300px; }
  }
</style>

<script>
  // Stat counter animation
  const counters = document.querySelectorAll<HTMLElement>(".counter-value");
  if (counters.length > 0) {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const animate = (el: HTMLElement) => {
      const target = parseInt(el.dataset.end || "0", 10);
      const suffix = el.dataset.suffix || "";
      if (reduceMotion) { el.textContent = target + suffix; return; }
      const duration = 2000;
      const start = performance.now();
      const tick = (now: number) => {
        const elapsed = now - start;
        const progress = Math.min(elapsed / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = Math.round(eased * target) + suffix;
        if (progress < 1) requestAnimationFrame(tick);
        else el.textContent = target + suffix;
      };
      requestAnimationFrame(tick);
    };
    if ("IntersectionObserver" in window) {
      const obs = new IntersectionObserver(
        (entries) => { entries.forEach((e) => { if (e.isIntersecting) { animate(e.target as HTMLElement); obs.unobserve(e.target); } }); },
        { threshold: 0.4 }
      );
      counters.forEach((c) => obs.observe(c));
    } else {
      counters.forEach((c) => animate(c));
    }
  }
</script>
