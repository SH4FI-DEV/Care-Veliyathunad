---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import SectionHeading from "../components/SectionHeading.astro";
import OptimisedImage from "../components/OptimisedImage.astro";
import ImageSlider from "../components/ImageSlider.astro";
import ProjectSlider from "../components/ProjectSlider.astro";
import TestimonialCarousel from "../components/TestimonialCarousel.astro";
import TeamShowcase from "../components/TeamShowcase.astro";
import ImageMarquee from "../components/ImageMarquee.astro";
import { SITE, IMPACT } from "../data/site";
import { PROJECTS, COUNTS, FEATURED_PROJECTS, getProject } from "../data/projects";
import { WORKING_TEAM, SOCIETY_LEADERS } from "../data/team";
import { JOURNEY_STEPS, TESTIMONIALS } from "../data/faqs";
import { IMAGE_POOL, unsplash } from "../data/images";

// Hero slider images - authentic Kerala project photos
const heroImages = [
  { src: unsplash(IMAGE_POOL.HOME_RURAL_01, 1600, 70), alt: "A simple new home in rural Kerala" },
  { src: unsplash(IMAGE_POOL.HOME_SIMPLE_03, 1600, 70), alt: "Volunteers at a construction site" },
  { src: unsplash(IMAGE_POOL.HANDOVER_04, 1600, 70), alt: "Family at the doorway of a new home" },
  { src: unsplash(IMAGE_POOL.HOME_RURAL_02, 1600, 70), alt: "Another completed home in Kerala" },
];

// Pick the most recent delivered project as the featured story
const FEATURED_STORY = PROJECTS.filter((p) => p.status === "delivered").slice(-1)[0];

// Suppress unused-var lint
void IMPACT; void FEATURED_PROJECTS; void getProject;
---

<Layout
  title="Building Homes. Building Hope."
  description="Care Veliyathunadu builds simple, dignified homes for families in need in Veliyathunadu, Kerala. With contributions of ₹1,000 from anyone who wishes to be part of the work."
>
  <!-- ============================================================
       1. HERO — full-width editorial with Ken Burns effect
       ============================================================ -->
  <section class="hero-banner relative overflow-hidden" style="min-height: 100vh; min-height: 100dvh;">
    <!-- Background image with Ken Burns effect -->
    <div class="absolute inset-0 z-0">
      <div class="hero-bg-slider absolute inset-0">
        {heroImages.map((img, i) => (
          <div 
            class={`hero-bg-slide absolute inset-0 transition-opacity duration-[2000ms] ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
            data-index={i}
          >
            <img
              src={img.src}
              alt={img.alt}
              class="w-full h-full object-cover scale-105"
              style="animation: kenBurns 20s ease-in-out infinite alternate;"
              loading={i === 0 ? "eager" : "lazy"}
            />
          </div>
        ))}
      </div>
      <!-- Gradient overlay -->
      <div class="absolute inset-0 bg-gradient-to-r from-brand-900/95 via-brand-900/70 to-brand-900/30"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-brand-900/50 via-transparent to-transparent"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 flex flex-col justify-end min-h-[100vh] min-h-[100dvh] pb-20 md:pb-28">
      <div class="container-x">
        <div class="grid lg:grid-cols-12 gap-12 items-end">
          <!-- Left: Main typography -->
          <div class="lg:col-span-7">
            <!-- Eyebrow -->
            <div class="flex items-center gap-4 mb-8 reveal">
              <div class="w-12 h-px bg-amber-400"></div>
              <p class="font-sans text-[13px] uppercase tracking-[0.25em] text-cream-100/70 font-medium">
                Care Veliyathunadu · Since 2021
              </p>
            </div>
            
            <!-- Headline -->
            <h1 class="font-display text-cream-50 text-[2.8rem] sm:text-[3.8rem] md:text-[4.5rem] lg:text-[5.5rem] xl:text-[6.5rem] leading-[0.92] tracking-tight mb-8 reveal">
              Building<br/>
              <span class="relative inline-block">
                <span class="relative z-10">Homes,</span>
                <span class="absolute bottom-[0.05em] left-0 right-0 h-[0.12em] bg-amber-400/40 z-0"></span>
              </span><br/>
              <span class="text-amber-400">Building</span><br/>
              <span class="text-cream-100/90">Hope.</span>
            </h1>
            
            <!-- Description -->
            <p class="text-cream-100/75 text-[17px] md:text-[19px] max-w-lg leading-[1.7] mb-12 reveal">
              We build simple, dignified homes for families in Veliyathunadu, Kerala, with contributions of ₹1,000 from anyone who wishes to be part of the work.
            </p>
            
            <!-- CTAs -->
            <div class="flex flex-wrap items-center gap-5 reveal">
              <a href="/contact#donate" class="group inline-flex items-center gap-3 bg-amber-400 hover:bg-amber-500 text-ink-900 px-8 py-4 rounded-md font-sans font-bold text-[15px] tracking-wide transition-all duration-300 hover:gap-4">
                Support Our Work
                <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
              <a href="/projects" class="group inline-flex items-center gap-3 text-cream-50 font-sans font-semibold text-[15px] border-b border-cream-100/30 hover:border-amber-400/60 pb-1 transition-all duration-300 hover:gap-4">
                See our projects
                <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            </div>
          </div>
          
          <!-- Right: Stats column -->
          <div class="lg:col-span-4 lg:col-start-9 hidden lg:block">
            <div class="space-y-8 reveal">
              <!-- Stats -->
              {[
                { value: "5+", label: "Homes Built" },
                { value: "21+", label: "Lives Changed" },
                { value: "323+", label: "Contributors" },
                { value: "₹1,000", label: "Starting Amount" },
              ].map((stat) => (
                <div class="border-l-2 border-amber-400/40 pl-6">
                  <div class="font-display text-[2.5rem] text-cream-50 leading-none">{stat.value}</div>
                  <div class="font-sans text-cream-100/60 text-[13px] uppercase tracking-[0.15em] mt-2">{stat.label}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
      
      <!-- Slide indicators -->
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex items-center gap-3 z-10">
        {heroImages.map((_, i) => (
          <button 
            class={`hero-indicator transition-all duration-500 ${i === 0 ? 'w-10 h-1 bg-amber-400' : 'w-4 h-1 bg-cream-100/30 hover:bg-cream-100/50'}`}
            data-index={i}
            aria-label={`Slide ${i + 1}`}
          />
        ))}
      </div>
      
      <!-- Scroll indicator -->
      <div class="absolute bottom-8 right-8 z-10 hidden md:flex flex-col items-center gap-3 reveal">
        <span class="font-sans text-[10px] uppercase tracking-[0.2em] text-cream-100/50" style="writing-mode: vertical-rl;">Scroll</span>
        <div class="w-px h-12 bg-gradient-to-b from-cream-100/50 to-transparent"></div>
      </div>
    </div>
  </section>

  <style>
    @keyframes kenBurns {
      0% { transform: scale(1.05) translate(0, 0); }
      100% { transform: scale(1.12) translate(-1%, -1%); }
    }
    
    .hero-indicator {
      cursor: pointer;
      border: none;
      outline: none;
    }
    .hero-indicator:focus-visible {
      outline: 2px solid var(--color-amber-400);
      outline-offset: 2px;
    }
    
    @media (prefers-reduced-motion: reduce) {
      .hero-bg-slide img {
        animation: none !important;
      }
    }
  </style>

  <script>
    // Hero background slider
    const heroSlides = document.querySelectorAll('.hero-bg-slide');
    const heroIndicators = document.querySelectorAll('.hero-indicator');
    let currentSlide = 0;
    const slideCount = heroSlides.length;
    
    function goToSlide(index: number) {
      heroSlides.forEach((slide, i) => {
        (slide as HTMLElement).style.opacity = i === index ? '1' : '0';
      });
      heroIndicators.forEach((ind, i) => {
        if (i === index) {
          ind.classList.remove('w-4');
          ind.classList.add('w-10', 'bg-amber-400');
          ind.classList.remove('bg-cream-100/30');
        } else {
          ind.classList.remove('w-10', 'bg-amber-400');
          ind.classList.add('w-4', 'bg-cream-100/30');
        }
      });
      currentSlide = index;
    }
    
    heroIndicators.forEach((ind, i) => {
      ind.addEventListener('click', () => goToSlide(i));
    });
    
    // Auto-advance slides
    setInterval(() => {
      goToSlide((currentSlide + 1) % slideCount);
    }, 6000);
  </script>

  <!-- ============================================================
       EDITORIAL STATEMENT — Large typographic statement
       ============================================================ -->
  <section class="py-24 md:py-32 lg:py-40 bg-cream-50">
    <div class="container-x max-w-4xl">
      <blockquote class="reveal">
        <p class="font-display text-[1.8rem] sm:text-[2.2rem] md:text-[2.8rem] lg:text-[3.2rem] leading-[1.15] text-ink-900 tracking-tight">
          "A home is more than four walls.<br/>
          It is security, dignity and a place to begin again."
        </p>
      </blockquote>
    </div>
  </section>

  <!-- ============================================================
       2. IMPACT — editorial typography with animated counters
       ============================================================ -->
  <section class="py-20 md:py-28 bg-cream-100">
    <div class="container-x">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12">
        {[
          { value: COUNTS.homesDelivered, label: "Homes delivered", sub: "Simple, dignified, complete" },
          { value: COUNTS.homesInProgress, label: "Currently building", sub: "Sixth home, in progress" },
          { value: COUNTS.totalBeneficiaries, suffix: "+", label: "Lives supported", sub: "Families with a new door" },
          { value: COUNTS.totalContributors, suffix: "+", label: "Contributors", sub: "From across Kerala and beyond" },
        ].map((stat, i) => (
          <div class="reveal" style={`animation-delay: ${i * 100}ms`}>
            <div class="font-display text-[2.5rem] md:text-[3.5rem] leading-none text-ink-900">
              <span 
                class="counter-value" 
                data-end={stat.value} 
                data-suffix={stat.suffix || ""} 
                data-duration="2000"
              >
                0{stat.suffix || ""}
              </span>
            </div>
            <div class="mt-3 font-sans font-semibold text-ink-900 text-[15px]">
              {stat.label}
            </div>
            <div class="mt-1 text-ink-500 text-[13px] leading-snug">
              {stat.sub}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       3. THE FAMILIES — project slider with info cards
       ============================================================ -->
  <section class="py-20 md:py-32 bg-cream-50" id="projects">
    <div class="container-x">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12 reveal">
        <div>
          <p class="font-sans text-xs uppercase tracking-[0.2em] text-ink-500 font-semibold mb-4">The families</p>
          <h2 class="font-display text-[2rem] md:text-[2.8rem] lg:text-[3.2rem] leading-[1.05] text-ink-900">
            Five families.<br/>Five new beginnings.
          </h2>
        </div>
        <a href="/projects" class="btn-tertiary hidden md:inline-flex">
          See all projects
          <Icon name="arrow-right" size={16} />
        </a>
      </div>

      <!-- Project slider -->
      <ProjectSlider projects={PROJECTS.filter((p) => p.status === "delivered")} />

      <div class="mt-8 text-center md:hidden reveal">
        <a href="/projects" class="btn-secondary">
          See all projects
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       4. FEATURED PROJECT — latest project showcase
       ============================================================ -->
  {FEATURED_STORY && (
    <section class="py-20 md:py-32">
      <div class="container-x">
        <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          <!-- Image -->
          <div class="lg:col-span-7 reveal">
            <div class="aspect-[4/3] overflow-hidden bg-cream-200 rounded-lg">
              <img
                src={FEATURED_STORY.cover}
                alt={FEATURED_STORY.familyName}
                class="w-full h-full object-cover transition-transform duration-700 hover:scale-[1.03]"
                loading="lazy"
              />
            </div>
          </div>
          
          <!-- Content -->
          <div class="lg:col-span-5 reveal">
            <p class="font-sans text-xs uppercase tracking-[0.2em] text-ink-500 font-semibold mb-3">Featured Project</p>
            <h3 class="font-display text-[2rem] md:text-[2.5rem] lg:text-[3rem] leading-[1.05] text-ink-900 mb-4">
              {FEATURED_STORY.familyName}
            </h3>
            <div class="flex items-center gap-4 text-sm text-ink-500 mb-6">
              <span>{FEATURED_STORY.location}, {FEATURED_STORY.district}</span>
              <span>·</span>
              <span>{FEATURED_STORY.beneficiaries} family members</span>
            </div>
            <p class="text-ink-700 text-[16px] leading-[1.7] mb-8">
              {FEATURED_STORY.story}
            </p>
            <a href={`/projects/${FEATURED_STORY.slug}`} class="btn-primary">
              View Project
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ============================================================
       5. GALLERY — masonry editorial layout
       ============================================================ -->
  <section class="py-20 md:py-32 bg-cream-50">
    <div class="container-x">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12 reveal">
        <div>
          <p class="font-sans text-xs uppercase tracking-[0.2em] text-ink-500 font-semibold mb-4">Gallery</p>
          <h2 class="font-display text-[2rem] md:text-[2.8rem] lg:text-[3.2rem] leading-[1.05] text-ink-900">
            A visual record<br/>of the work.
          </h2>
        </div>
        <a href="/gallery" class="btn-tertiary hidden md:inline-flex">
          View full gallery
          <Icon name="arrow-right" size={16} />
        </a>
      </div>

      <!-- Masonry grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <!-- Large image -->
        <div class="col-span-2 row-span-2 aspect-square overflow-hidden bg-cream-200 rounded-lg reveal">
          <img
            src={unsplash(IMAGE_POOL.HOME_RURAL_01, 800)}
            alt="Completed home in Kerala"
            class="w-full h-full object-cover transition-transform duration-700 hover:scale-105 cursor-pointer"
            loading="lazy"
          />
        </div>
        <!-- Small images -->
        <div class="aspect-square overflow-hidden bg-cream-200 rounded-lg reveal delay-1">
          <img
            src={unsplash(IMAGE_POOL.HOME_SIMPLE_03, 400)}
            alt="Construction in progress"
            class="w-full h-full object-cover transition-transform duration-700 hover:scale-105 cursor-pointer"
            loading="lazy"
          />
        </div>
        <div class="aspect-square overflow-hidden bg-cream-200 rounded-lg reveal delay-2">
          <img
            src={unsplash(IMAGE_POOL.HANDOVER_04, 400)}
            alt="Family at doorway"
            class="w-full h-full object-cover transition-transform duration-700 hover:scale-105 cursor-pointer"
            loading="lazy"
          />
        </div>
        <div class="aspect-square overflow-hidden bg-cream-200 rounded-lg reveal delay-1">
          <img
            src={unsplash(IMAGE_POOL.BUILDING_01, 400)}
            alt="Building materials"
            class="w-full h-full object-cover transition-transform duration-700 hover:scale-105 cursor-pointer"
            loading="lazy"
          />
        </div>
        <div class="aspect-square overflow-hidden bg-cream-200 rounded-lg reveal delay-2">
          <img
            src={unsplash(IMAGE_POOL.VOLUNTEER_01, 400)}
            alt="Volunteers at work"
            class="w-full h-full object-cover transition-transform duration-700 hover:scale-105 cursor-pointer"
            loading="lazy"
          />
        </div>
      </div>

      <div class="mt-8 text-center md:hidden reveal">
        <a href="/gallery" class="btn-secondary">
          View full gallery
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       6. THE PEOPLE — creative team showcase
       ============================================================ -->
  <section class="py-20 md:py-32">
    <div class="container-x">
      <TeamShowcase members={[...WORKING_TEAM]} />
    </div>
  </section>

  <!-- ============================================================
       7. TESTIMONIALS — community leader carousel
       ============================================================ -->
  <section class="py-20 md:py-32 bg-sage-100">
    <div class="container-x">
      <div class="text-center mb-16 reveal">
        <p class="font-sans text-xs uppercase tracking-[0.2em] text-ink-500 font-semibold mb-4">Community voices</p>
        <h2 class="font-display text-[2rem] md:text-[2.8rem] lg:text-[3.2rem] leading-[1.05] text-ink-900">
          What leaders are saying.
        </h2>
      </div>

      <TestimonialCarousel testimonials={[...TESTIMONIALS]} autoPlay={true} interval={7000} />
    </div>
  </section>

  <!-- ============================================================
       8. CTA — creative emotional section
       ============================================================ -->
  <section class="relative py-24 md:py-32 overflow-hidden">
    <!-- Background image with Ken Burns effect -->
    <div class="absolute inset-0">
      <img
        src={unsplash(IMAGE_POOL.HANDOVER_04, 1920, 60)}
        alt="Family at handover"
        class="w-full h-full object-cover ken-burns"
      />
      <div class="absolute inset-0 bg-brand-900/85"></div>
    </div>
    
    <div class="container-x relative z-10 text-center">
      <div class="max-w-3xl mx-auto reveal">
        <p class="font-sans text-xs uppercase tracking-[0.2em] text-cream-100/60 font-semibold mb-6">Join the work</p>
        <h2 class="font-display text-[2.5rem] md:text-[3.5rem] lg:text-[4rem] leading-[1.0] text-cream-50 mb-8">
          Every home begins<br/>with one act of kindness.
        </h2>
        <p class="text-cream-100/80 text-[18px] md:text-[20px] leading-[1.65] max-w-xl mx-auto mb-12">
          A sixth home is currently being built. Your ₹1,000 contribution joins you to the people who will live there.
        </p>
        
        <!-- Progress bar -->
        <div class="max-w-md mx-auto mb-10">
          <div class="flex justify-between text-sm text-cream-100/60 mb-2">
            <span>Home #6 Progress</span>
            <span>65%</span>
          </div>
          <div class="h-2 bg-cream-100/20 rounded-full overflow-hidden">
            <div class="h-full bg-amber-400 rounded-full transition-all duration-1000" style="width: 65%"></div>
          </div>
        </div>
        
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/contact#donate" class="btn-primary !h-14 !px-8">
            Support a Home
            <Icon name="arrow-right" size={18} />
          </a>
          <a href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener" class="btn-secondary !border-cream-100/30 !text-cream-50 hover:!bg-cream-50/10 !h-14 !px-8">
            <Icon name="chat" size={18} />
            Talk to Us
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       9. BEHIND THE SCENES — image marquee
       ============================================================ -->
  <section class="py-16 bg-cream-50">
    <div class="container-x mb-8">
      <p class="font-sans text-xs uppercase tracking-[0.2em] text-ink-500 font-semibold text-center reveal">Behind the scenes</p>
    </div>
    
    <ImageMarquee 
      images={[
        { src: unsplash(IMAGE_POOL.BUILDING_01, 700), alt: "Construction work", caption: "Foundation work" },
        { src: unsplash(IMAGE_POOL.VOLUNTEER_01, 700), alt: "Volunteers", caption: "Community volunteers" },
        { src: unsplash(IMAGE_POOL.HOME_RURAL_01, 700), alt: "Completed home", caption: "Home #1 Complete" },
        { src: unsplash(IMAGE_POOL.CONSTRUCTION_01, 700), alt: "Building", caption: "Raising the walls" },
        { src: unsplash(IMAGE_POOL.HANDOVER_04, 700), alt: "Handover", caption: "Key handover ceremony" },
        { src: unsplash(IMAGE_POOL.HOME_SIMPLE_03, 700), alt: "New home", caption: "A new beginning" },
      ]}
      speed={35}
    />
  </section>
</Layout>

<style>
  .ken-burns {
    animation: kenBurns 20s ease-in-out infinite alternate;
  }
  
  @keyframes kenBurns {
    0% {
      transform: scale(1);
    }
    100% {
      transform: scale(1.1);
    }
  }
  
  @media (prefers-reduced-motion: reduce) {
    .ken-burns {
      animation: none;
    }
  }
</style>

<style>
  .hero-dot {
    width: 28px;
    height: 3px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.35);
    transition: all 0.3s ease;
  }
  .hero-dot.is-active {
    background: var(--color-saffron-300);
    width: 38px;
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  // Hero carousel
  const slides = document.querySelectorAll<HTMLElement>(".hero-slide");
  const dots   = document.querySelectorAll<HTMLElement>(".hero-dot");
  let current  = 0;
  let timer: number | null = null;
  const showSlide = (i: number) => {
    slides.forEach((s, idx) => s.classList.toggle("is-active", idx === i));
    dots.forEach((d, idx) => d.classList.toggle("is-active", idx === i));
    current = i;
  };
  const next = () => showSlide((current + 1) % slides.length);
  dots.forEach((d, i) => d.addEventListener("click", () => { showSlide(i); restart(); }));
  const restart = () => { if (timer) clearInterval(timer); timer = window.setInterval(next, 6000); };
  restart();

  // ============================================================
  // STAT COUNTER ANIMATION
  // Animates the .stat-counter numbers from 0 up to the value
  // in data-target. Triggered when the section enters the viewport
  // (one-time animation). Respects prefers-reduced-motion.
  // ============================================================
  const counters = document.querySelectorAll<HTMLElement>(".stat-counter");
  if (counters.length > 0) {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const animate = (el: HTMLElement) => {
      const target = parseInt(el.dataset.target || "0", 10);
      const suffix = el.dataset.suffix || "";
      if (reduceMotion) {
        el.textContent = target + suffix;
        return;
      }
      const duration = 1800; // ms
      const start = performance.now();
      const tick = (now: number) => {
        const elapsed = now - start;
        const progress = Math.min(elapsed / duration, 1);
        // Ease-out cubic for a nice deceleration
        const eased = 1 - Math.pow(1 - progress, 3);
        const value = Math.round(eased * target);
        el.textContent = value + suffix;
        if (progress < 1) requestAnimationFrame(tick);
        else el.textContent = target + suffix;
      };
      requestAnimationFrame(tick);
    };

    if ("IntersectionObserver" in window) {
      const obs = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              animate(e.target as HTMLElement);
              obs.unobserve(e.target);
            }
          });
        },
        { threshold: 0.4 }
      );
      counters.forEach((c) => obs.observe(c));
    } else {
      counters.forEach((c) => animate(c));
    }
  }
</script>