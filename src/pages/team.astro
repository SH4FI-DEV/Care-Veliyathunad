---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { WORKING_TEAM, SOCIETY_LEADERS } from "../data/team";
---

<Layout
  title="The people behind every home"
  description="The 15 working organisers of Care Veliyathunadu, and the community of contributors, masons, and volunteers who make the work possible."
>
  <!-- HERO -->
  <section class="pt-12 md:pt-20 pb-10">
    <div class="container-x">
      <div class="max-w-3xl reveal">
        <p class="eyebrow">Our people</p>
        <h1 class="heading-display mt-4 text-[2.6rem] md:text-[3.4rem] lg:text-[4rem]">
          The people behind every home.
        </h1>
        <p class="mt-5 text-ink-700 text-[17px] md:text-[18px] leading-[1.7]">
          Fifteen working organisers, and a wider community of contributors, masons, and volunteers. Photographs below are placeholder images — real photographs will be added with each person's consent.
        </p>
      </div>
    </div>
  </section>

  <!-- WORKING TEAM -->
  <section class="pb-16 md:pb-24" id="working">
    <div class="container-x">
      <div class="flex items-end justify-between flex-wrap gap-4 mb-12 reveal">
        <div>
          <p class="eyebrow">Working team</p>
          <h2 class="heading-display mt-2 text-[2rem] md:text-[2.4rem]">The 15 who make it happen</h2>
        </div>
        <div class="text-sm text-ink-500">{WORKING_TEAM.length} organisers</div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-x-5 gap-y-12">
        {WORKING_TEAM.map((m, i) => (
          <div class="text-center reveal">
            <div
              class="aspect-square w-full max-w-[180px] mx-auto rounded-full overflow-hidden bg-cream-200"
              aria-hidden="true"
            >
              <img
                src={m.photo}
                alt={m.name}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <p class="mt-4 font-semibold text-ink-900 leading-snug text-sm">{m.name}</p>
            <p class="text-xs text-ink-500 mt-1 leading-snug">{m.role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SOCIETY LEADERS -->
  <section class="section-y bg-cream-50 border-y border-cream-200" id="leaders">
    <div class="container-x">
      <div class="max-w-2xl mb-12 reveal">
        <p class="eyebrow">Voices in the community</p>
        <h2 class="heading-display mt-3 text-[2rem] md:text-[2.4rem]">Endorsements and statements</h2>
        <p class="mt-5 text-ink-700 text-[16px] leading-[1.7]">
          Verified, on-record quotations from people in the community who have supported the work.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        {SOCIETY_LEADERS.map((l) => (
          <figure class="card-base p-7 reveal">
            <blockquote class="font-display italic text-[1.15rem] text-ink-700 leading-[1.55]">
              "{l.quote}"
            </blockquote>
            <figcaption class="mt-5 pt-5 border-t border-cream-200 flex items-center gap-3">
              <div
                class="w-10 h-10 rounded-full overflow-hidden bg-cream-200"
                aria-hidden="true"
              >
                <img
                  src={l.photo}
                  alt={l.name}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
              <div>
                <div class="text-sm font-semibold text-ink-900">{l.name}</div>
                <div class="text-xs text-ink-500 mt-0.5">{l.designation}</div>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- JOIN CTA -->
  <section class="py-16">
    <div class="container-x">
      <div class="max-w-2xl reveal">
        <p class="eyebrow">Get involved</p>
        <h2 class="heading-display mt-3 text-[2rem] md:text-[2.4rem]">If you have time, we have work.</h2>
        <p class="mt-5 text-ink-700 text-[16px] leading-[1.7]">
          Whether you are an engineer, a mason, a photographer, or simply someone with a few extra hours on a weekend — there is room for you in this work.
        </p>
        <a href="/contact" class="btn-primary mt-6">
          <Icon name="mail" size={16} /> Get in touch
        </a>
      </div>
    </div>
  </section>
</Layout>